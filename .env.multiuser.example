# Copy to .env and replace these values. Keep .env out of Git.
MULTIUSER_PORT=8200
MULTIUSER_HOST=127.0.0.1
MULTIUSER_DATA_DIR=.multiuser-data
PINMAP_INVITE_CODE=replace-with-a-long-random-secret
PUBLIC_ORIGIN=http://127.0.0.1:8200
MULTIUSER_AI_PROVIDER=ollama
MULTIUSER_MODEL=qwen2.5vl:3b
WORKER_CONCURRENCY=1
MULTIUSER_DAILY_JOB_LIMIT=50
MULTIUSER_MAX_IMAGES=20
# Audio transcription is required for posts with an audio track.
# Local Mac: install whisper-cli and a multilingual ggml model, then set:
# ASR_PROVIDER=whisper_cli
# WHISPER_MODEL_PATH=.models/ggml-base.bin
# WHISPER_CLI_PATH=whisper-cli
# GPU deployment: use a separate vLLM speech-to-text server:
# ASR_PROVIDER=vllm
# ASR_BASE_URL=http://private-asr-host:8001/v1
# ASR_MODEL=openai/whisper-large-v3-turbo
# ASR_API_KEY=replace-with-private-asr-key
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# GPU deployment: MULTIUSER_AI_PROVIDER=vllm, MULTIUSER_MODEL=<vision-model>
# VLLM_BASE_URL=http://private-gpu-host:8000/v1
# VLLM_API_KEY=replace-with-private-model-key
