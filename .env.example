OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PORT=8101
# Optional: directory containing pinmap-items.json and collector/results/.
# If unset, the local legacy data directory or bundled export fixture is used.
# SOURCE_ROOT=/absolute/path/to/input-data
# Optional: use a system FFmpeg binary instead of the bundled binary.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
